# Copy this file to .env and fill in your real PostgreSQL connection details.
# .env is gitignored — never commit real credentials.

PGHOST=localhost
PGPORT=5432
PGDATABASE=frs_insurance
PGUSER=postgres
PGPASSWORD=
PGSSL=false
PG_POOL_MAX=10

PORT=4000
HOST=0.0.0.0

UPLOAD_DIR=uploads

# Optional: restricts the API to specific browser origins (comma-separated).
# Unset = open to every origin (today's default). Only needed if you want to
# lock the API down to your known frontend origin(s).
# CORS_ORIGIN=http://localhost:4200,http://localhost:4300

# Optional: powers the "Try AI Extraction" fallback for insurers with no
# hand-written parser. Free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
