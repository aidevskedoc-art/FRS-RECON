# Copy this file to .env and fill in your real PostgreSQL connection details.
# .env is gitignored — never commit real credentials.

PGHOST=localhost
PGPORT=5432
PGDATABASE=frs_insurance
PGUSER=postgres
PGPASSWORD=
PGSSL=false
PG_POOL_MAX=10

PORT=4000
HOST=0.0.0.0

UPLOAD_DIR=uploads

# Optional: powers the "Try AI Extraction" fallback for insurers with no
# hand-written parser. Free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
