# Copy this file to .env and fill in your real PostgreSQL connection details.
# .env is gitignored — never commit real credentials.

PGHOST=localhost
PGPORT=5432
# Historical name — this database holds the reconciliation data.
PGDATABASE=frs_insurance
PGUSER=postgres
PGPASSWORD=
PGSSL=false
PG_POOL_MAX=10

PORT=4000
HOST=0.0.0.0

# Optional: restricts the API to specific browser origins (comma-separated).
# Unset = open to every origin (today's default). Only needed if you want to
# lock the API down to your known frontend origin(s).
# CORS_ORIGIN=http://localhost:4200

# Optional: key that encrypts the shared-folder password (Shared Folder
# Automation screen). Falls back to JWT_SECRET. Changing it means the share
# password must be re-entered on that screen.
# FOLDER_WATCH_KEY=
